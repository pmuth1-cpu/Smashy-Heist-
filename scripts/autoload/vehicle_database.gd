func _ready() -> void:
	print("VehicleDatabase: Initialized with %d vehicles (%d COMMON, %d RARE, %d EPIC, %d LEGENDARY, %d MYTHIC)." % [
		VEHICLES.size(), get_common_cars().size(), get_rare_cars().size(), get_epic_cars().size(), get_legendary_cars().size(), get_mythic_cars().size()
	])

## Returns the dictionary entry for a given vehicle ID (fallback to default_coupe)
func get_car(car_id: String) -> Dictionary:
	if VEHICLES.has(car_id):
		return VEHICLES[car_id]
	return VEHICLES["default_coupe"]

func has_car(car_id: String) -> bool:
	return VEHICLES.has(car_id)

func get_all_car_ids() -> Array[String]:
	var ids: Array[String] = []
	for k in VEHICLES.keys():
		ids.append(String(k))
	return ids

func get_cars_by_tier(tier: String) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for c in VEHICLES.values():
		if str(c.get("rarity_tier", "")) == tier:
			out.append(c)
	return out

func get_common_cars() -> Array[Dictionary]:
	return get_cars_by_tier("COMMON")

func get_rare_cars() -> Array[Dictionary]:
	return get_cars_by_tier("RARE")

func get_epic_cars() -> Array[Dictionary]:
	return get_cars_by_tier("EPIC")

func get_legendary_cars() -> Array[Dictionary]:
	return get_cars_by_tier("LEGENDARY")

func get_mythic_cars() -> Array[Dictionary]:
	return get_cars_by_tier("MYTHIC")

func get_cars_by_category(category: String) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for c in VEHICLES.values():
		if str(c.get("category", "")).to_upper() == category.to_upper():
			out.append(c)
	return out

## Creates or returns a populated CarStats resource for the vehicle
func get_car_stats(car_id: String) -> CarStats:
	var info: Dictionary = get_car(car_id)
	var cs := CarStats.new()
	cs.car_id = String(info.get("id", "default_coupe"))
	cs.car_name = String(info.get("name", "Brawler"))
	cs.rarity_tier = String(info.get("rarity_tier", "COMMON"))
	cs.rarity_color = info.get("rarity_color", Color("95afc0"))
	cs.special_perk_description = String(info.get("passive_desc", ""))
	
	cs.max_hp = float(info.get("max_hp", 180.0))
	
	# Scale normalized stats to physics units (balanced for readable, responsive arcade control)
	var norm_speed: float = float(info.get("speed", 0.65))
	var norm_accel: float = float(info.get("accel", 0.70))
	var norm_handl: float = float(info.get("handling", 0.75))
	
	cs.max_speed = 15.0 + norm_speed * 12.0
	cs.acceleration = 16.0 + norm_accel * 14.0
	cs.reverse_acceleration = cs.acceleration * 0.50
	cs.turn_speed = 2.4 + norm_handl * 1.5
	cs.drift_grip = 0.82 + norm_handl * 0.16
	cs.body_tilt_amount = 0.18
	cs.mass_weight = float(info.get("mass_weight", 2.0))
	return cs
